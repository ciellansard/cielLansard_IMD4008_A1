<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:top="0dp"
        android:left="0dp"
        android:right="0dp"
        android:bottom="0dp"
        android:backgroundTint = "@color/darkGrey">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/mint" />
        </shape>
    </item>

    <item
        android:top="9dp"
        android:left="9dp"
        android:right="9dp"
        android:bottom="9dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="90"
                android:startColor="@color/white"
                android:endColor="@color/mint"
                android:backgroundTint = "@color/mint" />
        </shape>
    </item>

    <item
        android:top="10dp"
        android:left="10dp"
        android:right="10dp"
        android:bottom="10dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="90"
                android:startColor="@color/olive"
                android:endColor="@color/oliveShadow"
                android:backgroundTint = "@color/mint" />
        </shape>
    </item>

    <item
        android:top="14dp"
        android:left="12dp"
        android:right="12dp"
        android:bottom="12dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/olive" />
        </shape>
    </item>
</layer-list>