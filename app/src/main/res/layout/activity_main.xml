<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/appContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:gravity = "center"
        android:stretchColumns = "*"
        android:background="@color/darkGrey">

        <TextView
            android:id="@+id/screen"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.5"

            android:layout_margin="4dp"
            android:padding="20dp"

            android:background="@drawable/screen"
            android:fontFamily="monospace"
            android:textSize="22dp"
            android:textColor="@color/darkGrey"
            android:shadowColor="@color/oliveShadow"
            android:shadowRadius="2"
            android:textStyle="bold"

            android:text = ""/>


        <GridLayout
            android:id="@+id/buttonContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.5"
            android:background="@color/darkGrey"
            android:columnCount="4"
            android:gravity="center"
            android:rowCount="6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:padding = "1dp">

            <TextView
                android:id="@+id/button7"

                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="4dp"
                android:paddingBottom="2.5dp"
                android:gravity="center"

                android:background="@drawable/button_mid_grey"
                android:fontFamily="monospace"
                android:textSize="22dp"
                android:textColor="@color/darkGrey"
                android:shadowColor="@color/midGreyShadow"
                android:shadowDy="-3"
                android:shadowRadius="1"
                android:textStyle="bold"

                android:onClick="appendCharacterToScreen"

                android:text = "7"/>
            <TextView
                android:id="@+id/button8"

                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="4dp"
                android:paddingBottom="2.5dp"
                android:gravity="center"

                android:background="@drawable/button_mid_grey"
                android:fontFamily="monospace"
                android:textSize="22dp"
                android:textColor="@color/darkGrey"
                android:shadowColor="@color/midGreyShadow"
                android:shadowDy="-3"
                android:shadowRadius="1"
                android:textStyle="bold"

                android:onClick="appendCharacterToScreen"

                android:text = "8"/>
            <TextView
                android:id="@+id/button9"

                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="4dp"
                android:paddingBottom="2.5dp"
                android:gravity="center"

                android:background="@drawable/button_mid_grey"
                android:fontFamily="monospace"
                android:textSize="22dp"
                android:textColor="@color/darkGrey"
                android:shadowColor="@color/midGreyShadow"
                android:shadowDy="-3"
                android:shadowRadius="1"
                android:textStyle="bold"

                android:onClick="appendCharacterToScreen"

                android:text = "9"/>
            <TextView
                android:id="@+id/buttonDivide"

                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="4dp"
                android:paddingBottom="2.5dp"
                android:gravity="center"

                android:background="@drawable/button_blue"
                android:fontFamily="monospace"
                android:textSize="22dp"
                android:textColor="@color/white"
                android:shadowColor="@color/blueShadow"
                android:shadowDy="-3"
                android:shadowRadius="1"
                android:textStyle="bold"

                android:onClick="appendCharacterToScreen"

                android:text = "÷"/>
            <TextView
                android:id="@+id/button4"

                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="4dp"
                android:paddingBottom="2.5dp"
                android:gravity="center"

                android:background="@drawable/button_mid_grey"
                android:fontFamily="monospace"
                android:textSize="22dp"
                android:textColor="@color/darkGrey"
                android:shadowColor="@color/midGreyShadow"
                android:shadowDy="-3"
                android:shadowRadius="1"
                android:textStyle="bold"

                android:onClick="appendCharacterToScreen"

                android:text = "4"/>
            <TextView
                android:id="@+id/button5"

                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="4dp"
                android:paddingBottom="2.5dp"
                android:gravity="center"

                android:background="@drawable/button_mid_grey"
                android:fontFamily="monospace"
                android:textSize="22dp"
                android:textColor="@color/darkGrey"
                android:shadowColor="@color/midGreyShadow"
                android:shadowDy="-3"
                android:shadowRadius="1"
                android:textStyle="bold"

                android:onClick="appendCharacterToScreen"

                android:text = "5"/>
            <TextView
                android:id="@+id/button6"

                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="4dp"
                android:paddingBottom="2.5dp"
                android:gravity="center"

                android:background="@drawable/button_mid_grey"
                android:fontFamily="monospace"
                android:textSize="22dp"
                android:textColor="@color/darkGrey"
                android:shadowColor="@color/midGreyShadow"
                android:shadowDy="-3"
                android:shadowRadius="1"
                android:textStyle="bold"

                android:onClick="appendCharacterToScreen"

                android:text = "6"/>
            <TextView
                android:id="@+id/buttonMultiply"

                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="4dp"
                android:paddingBottom="2.5dp"
                android:gravity="center"

                android:background="@drawable/button_blue"
                android:fontFamily="monospace"
                android:textSize="22dp"
                android:textColor="@color/white"
                android:shadowColor="@color/blueShadow"
                android:shadowDy="-3"
                android:shadowRadius="1"
                android:textStyle="bold"

                android:onClick="appendCharacterToScreen"

                android:text = "×"/>
            <TextView
                android:id="@+id/button1"

                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="4dp"
                android:paddingBottom="2.5dp"
                android:gravity="center"

                android:background="@drawable/button_mid_grey"
                android:fontFamily="monospace"
                android:textSize="22dp"
                android:textColor="@color/darkGrey"
                android:shadowColor="@color/midGreyShadow"
                android:shadowDy="-3"
                android:shadowRadius="1"
                android:textStyle="bold"

                android:onClick="appendCharacterToScreen"

                android:text = "1"/>
            <TextView
                android:id="@+id/button2"

                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="4dp"
                android:paddingBottom="2.5dp"
                android:gravity="center"

                android:background="@drawable/button_mid_grey"
                android:fontFamily="monospace"
                android:textSize="22dp"
                android:textColor="@color/darkGrey"
                android:shadowColor="@color/midGreyShadow"
                android:shadowDy="-3"
                android:shadowRadius="1"
                android:textStyle="bold"

                android:onClick="appendCharacterToScreen"

                android:text = "2"/>
            <TextView
                android:id="@+id/button3"

                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="4dp"
                android:paddingBottom="2.5dp"
                android:gravity="center"

                android:background="@drawable/button_mid_grey"
                android:fontFamily="monospace"
                android:textSize="22dp"
                android:textColor="@color/darkGrey"
                android:shadowColor="@color/midGreyShadow"
                android:shadowDy="-3"
                android:shadowRadius="1"
                android:textStyle="bold"

                android:onClick="appendCharacterToScreen"

                android:text = "3"/>
            <TextView
                android:id="@+id/buttonSubtract"

                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="4dp"
                android:paddingBottom="2.5dp"
                android:gravity="center"

                android:background="@drawable/button_blue"
                android:fontFamily="monospace"
                android:textSize="22dp"
                android:textColor="@color/white"
                android:shadowColor="@color/blueShadow"
                android:shadowDy="-3"
                android:shadowRadius="1"
                android:textStyle="bold"

                android:onClick="appendCharacterToScreen"

                android:text = "-"/>
            <TextView
                android:id="@+id/button0"

                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="4dp"
                android:paddingBottom="2.5dp"
                android:gravity="center"

                android:background="@drawable/button_mid_grey"
                android:fontFamily="monospace"
                android:textSize="22dp"
                android:textColor="@color/darkGrey"
                android:shadowColor="@color/midGreyShadow"
                android:shadowDy="-3"
                android:shadowRadius="1"
                android:textStyle="bold"

                android:onClick="appendCharacterToScreen"

                android:text = "0"/>
            <TextView
                android:id="@+id/buttonDecimal"

                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="4dp"
                android:paddingBottom="2.5dp"
                android:gravity="center"

                android:background="@drawable/button_mid_grey"
                android:fontFamily="monospace"
                android:textSize="22dp"
                android:textColor="@color/darkGrey"
                android:shadowColor="@color/midGreyShadow"
                android:shadowDy="-3"
                android:shadowRadius="1"
                android:textStyle="bold"

                android:onClick="appendCharacterToScreen"

                android:text = "."/>
            <TextView
                android:id="@+id/buttonSign"

                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="4dp"
                android:paddingBottom="2.5dp"
                android:gravity="center"

                android:background="@drawable/button_mid_grey"
                android:fontFamily="monospace"
                android:textSize="22dp"
                android:textColor="@color/darkGrey"
                android:shadowColor="@color/midGreyShadow"
                android:shadowDy="-3"
                android:shadowRadius="1"
                android:textStyle="bold"

                android:text = "(+/-)"/>
            <TextView
                android:id="@+id/buttonAdd"

                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="4dp"
                android:paddingBottom="2.5dp"
                android:gravity="center"

                android:background="@drawable/button_blue"
                android:fontFamily="monospace"
                android:textSize="22dp"
                android:textColor="@color/white"
                android:shadowColor="@color/blueShadow"
                android:shadowDy="-3"
                android:shadowRadius="1"
                android:textStyle="bold"

                android:onClick="appendCharacterToScreen"

                android:text = "+"/>
            <TextView
                android:id="@+id/buttonBracketOpen"

                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="4dp"
                android:paddingBottom="2.5dp"
                android:gravity="center"

                android:background="@drawable/button_dark_grey"
                android:fontFamily="monospace"
                android:textSize="22dp"
                android:textColor="@color/white"
                android:shadowColor="@color/black"
                android:shadowDy="-3"
                android:shadowRadius="1"
                android:textStyle="bold"

                android:onClick="appendCharacterToScreen"

                android:text = "("/>
            <TextView
                android:id="@+id/buttonBack"

                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="4dp"
                android:paddingBottom="2.5dp"
                android:gravity="center"

                android:background="@drawable/button_teal"
                android:fontFamily="monospace"
                android:textSize="22dp"
                android:textColor="@color/white"
                android:shadowColor="@color/tealShadow"
                android:shadowDy="-3"
                android:shadowRadius="1"
                android:textStyle="bold"

                android:onClick="deleteLastCharacter"

                android:text = "BACK"/>
            <TextView
                android:id="@+id/buttonStore"

                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="4dp"
                android:paddingBottom="2.5dp"
                android:gravity="center"

                android:background="@drawable/button_yellow"
                android:fontFamily="monospace"
                android:textSize="22dp"
                android:textColor="@color/white"
                android:shadowColor="@color/yellowShadow"
                android:shadowDy="-3"
                android:shadowRadius="1"
                android:textStyle="bold"

                android:text = "STORE"/>
            <TextView
                android:id="@+id/buttonEqual"

                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="4dp"
                android:paddingBottom="2.5dp"
                android:gravity="center"

                android:background="@drawable/button_blue"
                android:fontFamily="monospace"
                android:textSize="22dp"
                android:textColor="@color/white"
                android:shadowColor="@color/blueShadow"
                android:shadowDy="-3"
                android:shadowRadius="1"
                android:textStyle="bold"

                android:text = "="/>
            <TextView
                android:id="@+id/buttonBracketClosed"

                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="4dp"
                android:paddingBottom="2.5dp"
                android:gravity="center"

                android:background="@drawable/button_dark_grey"
                android:fontFamily="monospace"
                android:textSize="22dp"
                android:textColor="@color/white"
                android:shadowColor="@color/black"
                android:shadowDy="-3"
                android:shadowRadius="1"
                android:textStyle="bold"

                android:onClick="appendCharacterToScreen"

                android:text = ")"/>
            <TextView
                android:id="@+id/buttonClear"

                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="4dp"
                android:paddingBottom="2.5dp"
                android:gravity="center"

                android:background="@drawable/button_teal"
                android:fontFamily="monospace"
                android:textSize="22dp"
                android:textColor="@color/white"
                android:shadowColor="@color/tealShadow"
                android:shadowDy="-3"
                android:shadowRadius="1"
                android:textStyle="bold"

                android:onClick="clearScreen"

                android:text = "CLEAR"/>
            <TextView
                android:id="@+id/buttonRecall"

                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="4dp"
                android:paddingBottom="2.5dp"
                android:gravity="center"

                android:background="@drawable/button_yellow"
                android:fontFamily="monospace"
                android:textSize="22dp"
                android:textColor="@color/white"
                android:shadowColor="@color/yellowShadow"
                android:shadowDy="-3"
                android:shadowRadius="1"
                android:textStyle="bold"

                android:text = "RCALL"/>
            <TextView
                android:id="@+id/buttonHistory"

                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="4dp"
                android:paddingBottom="2.5dp"
                android:gravity="center"

                android:background="@drawable/button_yellow"
                android:fontFamily="monospace"
                android:textSize="22dp"
                android:textColor="@color/white"
                android:shadowColor="@color/yellowShadow"
                android:shadowDy="-3"
                android:shadowRadius="1"
                android:textStyle="bold"

                android:text = "HSTRY"/>
        </GridLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>